# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# Primer administrador (se crea solo si no existe ningún usuario). Cambie la clave al ingresar.
SINAPSIS_ADMIN_USUARIO=admin
SINAPSIS_ADMIN_CLAVE=cambie-esta-clave
SINAPSIS_SESION_HORAS=12

# Reglas de alertas
SINAPSIS_DIAS_ALERTA_VENCIMIENTO=30      # días antes del vencimiento para avisar
SINAPSIS_DIAS_ALERTA_PENDIENTE=5         # días sin llegar para marcar un pendiente como atrasado
SINAPSIS_PEDIDOS_DESABASTECIMIENTO=2     # pedidos seguidos sin llegar = posible desabastecimiento

# OCR local (Tesseract)
SINAPSIS_OCR_IDIOMA=spa+eng
SINAPSIS_OCR_MAX_SIMULTANEOS=1

# Respaldo con IA vía OpenRouter (opcional). Si se deja vacío, Sinapsis funciona sin IA.
# Use un modelo con visión; primero uno gratuito (sufijo :free) y uno barato como alterno.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=
OPENROUTER_MODELO_ALTERNO=
SINAPSIS_IA_LIMITE_DIARIO=50
SINAPSIS_IA_HABILITADA=true
